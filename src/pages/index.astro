---
const profile = {
  name: "Damian Pilny",
  monogram: "DP",
  headline: "Projektuję systemy wbudowane, które muszą działać za każdym razem.",
  role: "Embedded Software Engineer (R&D) · Co-Founder @ KoPilTech",
  location: "Gliwice / Katowice, PL",
  email: "kontakt@kopiltech.pl",
  summary:
    "Łączę inżynierię niskopoziomową (STM32, RTOS, TrustZone, BMS) z budową własnych urządzeń pomiarowych dla energetyki. Pracuję na styku architektury firmware, bezpieczeństwa funkcjonalnego i wdrożeń R&D.",
  links: {
    linkedin: "https://www.linkedin.com/in/damian-pilny-262377183/",
    github: "https://github.com/DamianPilny",
    substack: "https://inzyniermysli.substack.com/",
    company: "https://kopiltech.pl",
  },
};

const metrics = [
  { value: "6+ lat", label: "w R&D i energoelektronice" },
  { value: "1. miejsce", label: "Kopalnia Startupów (Katowice)" },
  { value: "STM32 / ARM", label: "RTOS · TrustZone · BMS" },
  { value: "Co-Founder", label: "KoPilTech Sp. z o.o." },
];

const projects = [
  {
    tag: "HARDWARE & PRODUKT · KOPILTECH",
    title: "PortableGrid ONE",
    desc: "Przenośne, bateryjne źródło napięcia AC (230 V / 58 V, czysty sinus THD ≤ 3%, USB-PD 45 W) do uruchamiania i weryfikacji liczników energii w terenie. Zwycięzca VI edycji Kopalni Startupów, po testach demonstracyjnych w SEP Gliwice.",
    stack: ["Energoelektronika", "Embedded C", "Prototypowanie", "R&D"],
    link: "https://kopiltech.pl",
    linkLabel: "Zobacz produkt ↗",
    featured: true,
  },
  {
    tag: "ARCHITEKTURA FIRMWARE",
    title: "Modułowy system BMS LFP",
    desc: "Oprogramowanie dla wieloogniwowych magazynów energii na STM32U5: izolacja Arm TrustZone, bezpieczny bootloader MCUboot z dual-bank OTA (UDS), estymacja SoC/SoH oraz praca równoległa pakietów po CANopen / LSS.",
    stack: ["STM32U5", "ThreadX", "TrustZone", "CANopen", "UDS"],
    featured: false,
  },
  {
    tag: "JAKOŚĆ I AUTOMATYZACJA",
    title: "Embedded CI/CD & MISRA Pipeline",
    desc: "Zautomatyzowane środowisko weryfikacji kodu C na self-hosted runnerze ARM64: testy jednostkowe off-target (Ceedling / Unity / CMock), raportowanie pokrycia gcovr, analiza statyczna MISRA C (cppcheck) i kontrola złożoności cyklomatycznej.",
    stack: ["Ceedling", "MISRA C", "CMake", "Docker", "CI/CD"],
    featured: false,
  },
  {
    tag: "PUBLIKACJE · SUBSTACK",
    title: "Inżynier Myśli",
    desc: "Newsletter o inżynierii systemów, budowaniu produktów sprzętowych, stoickim podejściu do przywództwa i dyscyplinie operacyjnej w pracy technicznej.",
    stack: ["Systems Thinking", "Leadership", "Hardware"],
    link: profile.links.substack,
    linkLabel: "Czytaj wpisy ↗",
    featured: false,
  },
];

const stackGroups = [
  {
    name: "MCU & RTOS",
    items: ["STM32 (U5, H5, G4)", "ARM Cortex-M33/M4", "Embedded C / C++", "Azure RTOS (ThreadX)", "FreeRTOS", "DMA / GPDMA"],
  },
  {
    name: "Security & Safety",
    items: ["Arm TrustZone", "MCUboot / SBSFU", "Dual-bank OTA", "MISRA C", "EU CRA / TARA", "ISO 13849-1"],
  },
  {
    name: "Protokoły & BMS",
    items: ["CAN / CANopen (LSS)", "UDS (ISO 14229)", "SMBus / I2C / SPI", "TI BQ76952 / BQ34Z100", "SoC / SoH"],
  },
  {
    name: "Tooling & QA",
    items: ["CMake / Ninja", "Ceedling / Unity / CMock", "cppcheck / gcovr", "Python", "Git / CI/CD", "Docker"],
  },
];

const experience = [
  {
    period: "Obecnie",
    role: "Co-Founder & Członek Zarządu",
    org: "KoPilTech Sp. z o.o.",
    desc: "Rozwój urządzeń pomiarowych i projektów R&D z obszaru elektroniki i energoelektroniki. Komercjalizacja PortableGrid ONE.",
  },
  {
    period: "2022 — obecnie",
    role: "Embedded Software Engineer (R&D)",
    org: "EMBS Sp. z o.o.",
    desc: "Projektowanie architektury oprogramowania wbudowanego, systemów BMS, komunikacji przemysłowej oraz automatyzacja testów i jakości kodu.",
  },
  {
    period: "2020 — 2023",
    role: "Embedded Software Developer",
    org: "ENTE Sp. z o.o.",
    desc: "Rozwój i weryfikacja oprogramowania wbudowanego w projektach R&D dla elektroniki przemysłowej.",
  },
  {
    period: "2016 — 2021",
    role: "mgr inż. Mechatronika, robotyka i automatyka",
    org: "Politechnika Śląska · ENEL-PC",
    desc: "Specjalność Systemy Pomiarowe i Informacyjne oraz praktyka produkcyjna w obszarze energoelektroniki.",
  },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} — Embedded Software Engineer &amp; Co-Founder</title>
    <meta name="description" content={profile.summary} />

    <!-- Open Graph / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.name} — Embedded Software Engineer & Co-Founder`} />
    <meta property="og:description" content={profile.summary} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>

    <div class="wrapper">
      <!-- NAV -->
      <header class="topbar">
        <a href="#" class="brand">
          <span class="monogram">{profile.monogram}</span>
          <span class="brand-name">{profile.name}</span>
        </a>
        <nav class="nav">
          <a href="#projekty">Projekty</a>
          <a href="#stack">Stack</a>
          <a href="#doswiadczenie">Doświadczenie</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener" class="nav-cta">
            LinkedIn ↗
          </a>
        </nav>
      </header>

      <main>
        <!-- HERO -->
        <section class="hero">
          <div class="hero-main">
            <div class="status-pill mono">
              <span class="dot"></span>
              EMBEDDED R&amp;D · HARDWARE FOUNDER
            </div>
            <h1>{profile.headline}</h1>
            <p class="summary">{profile.summary}</p>
            <div class="cta-row">
              <a class="btn primary" href={profile.links.linkedin} target="_blank" rel="noopener">
                Połączmy się na LinkedIn ↗
              </a>
              <a class="btn" href={profile.links.company} target="_blank" rel="noopener">
                KoPilTech.pl ↗
              </a>
              <a class="btn" href={profile.links.substack} target="_blank" rel="noopener">
                Inżynier Myśli ↗
              </a>
            </div>
          </div>

          <!-- SYSTEM PROFILE CARD -->
          <aside class="profile-card">
            <div class="card-header mono">
              <span>SYSTEM_PROFILE</span>
              <span class="accent">ONLINE</span>
            </div>
            <dl class="specs">
              <div>
                <dt class="mono">ROLA</dt>
                <dd>Embedded SW Engineer &amp; Co-Founder</dd>
              </div>
              <div>
                <dt class="mono">FOKUS</dt>
                <dd>STM32 · BMS · TrustZone · Energoelektronika</dd>
              </div>
              <div>
                <dt class="mono">LOKALIZACJA</dt>
                <dd>{profile.location}</dd>
              </div>
              <div>
                <dt class="mono">KONTAKT</dt>
                <dd class="email-row">
                  <span>{profile.email}</span>
                  <button type="button" id="copy-email" class="copy-btn mono" data-email={profile.email}>
                    Kopiuj
                  </button>
                </dd>
              </div>
            </dl>
            <div class="card-footer mono">
              <a href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
              <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
              <a href={profile.links.substack} target="_blank" rel="noopener">Substack ↗</a>
            </div>
          </aside>
        </section>

        <!-- METRICS STRIP -->
        <section class="metrics">
          {metrics.map((m) => (
            <div class="metric-item">
              <div class="metric-value mono">{m.value}</div>
              <div class="metric-label">{m.label}</div>
            </div>
          ))}
        </section>

        <!-- 01 / PROJEKTY (BENTO GRID) -->
        <section id="projekty" class="section">
          <div class="section-head">
            <p class="mono section-label">01 / PROOF OF WORK</p>
            <h2>Wybrane projekty i inicjatywy</h2>
          </div>

          <div class="bento">
            {projects.map((p) => (
              <article class={`bento-card ${p.featured ? "featured" : ""}`}>
                <div>
                  <span class="mono card-tag">{p.tag}</span>
                  <h3>{p.title}</h3>
                  <p>{p.desc}</p>
                </div>
                <div class="card-bottom">
                  <div class="pill-row">
                    {p.stack.map((tech) => (
                      <span class="pill mono">{tech}</span>
                    ))}
                  </div>
                  {p.link && (
                    <a href={p.link} target="_blank" rel="noopener" class="card-link mono">
                      {p.linkLabel}
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- 02 / TECH STACK -->
        <section id="stack" class="section">
          <div class="section-head">
            <p class="mono section-label">02 / KOMPETENCJE TECHNICZNE</p>
            <h2>Narzędzia i technologie</h2>
          </div>

          <div class="stack-grid">
            {stackGroups.map((g) => (
              <div class="stack-card">
                <h3 class="mono">{g.name}</h3>
                <div class="pill-row">
                  {g.items.map((item) => (
                    <span class="pill mono">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 03 / DOŚWIADCZENIE -->
        <section id="doswiadczenie" class="section">
          <div class="section-head">
            <p class="mono section-label">03 / ŚCIEŻKA ZAWODOWA</p>
            <h2>Doświadczenie i edukacja</h2>
          </div>

          <div class="timeline">
            {experience.map((e) => (
              <article class="timeline-item">
                <div class="timeline-meta mono">{e.period}</div>
                <div class="timeline-body">
                  <h3>{e.role} <span class="org">· {e.org}</span></h3>
                  <p>{e.desc}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      </main>

      <!-- FOOTER -->
      <footer class="footer">
        <div class="mono">© {new Date().getFullYear()} {profile.name}</div>
        <div class="footer-links mono">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span>·</span>
          <a href={profile.links.company} target="_blank" rel="noopener">kopiltech.pl</a>
          <span>·</span>
          <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </footer>
    </div>

    <script>
      const btn = document.getElementById("copy-email");
      btn?.addEventListener("click", async () => {
        const email = btn.getAttribute("data-email");
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          const original = btn.textContent;
          btn.textContent = "Skopiowano ✓";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove("copied");
          }, 1800);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #08090c;
    --surface: #111318;
    --surface-2: #161922;
    --border: #232733;
    --border-hover: #383f52;
    --text: #f4f4f5;
    --muted: #9ca3af;
    --accent: #10b981;
    --accent-soft: rgba(16, 185, 129, 0.12);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    position: relative;
    overflow-x: hidden;
  }

  .mono {
    font-family: "JetBrains Mono", monospace;
  }

  /* Architectural background */
  .bg-grid {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 50%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .bg-glow {
    position: fixed;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    width: 780px;
    height: 360px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.14) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .wrapper {
    position: relative;
    z-index: 1;
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Topbar */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text);
  }

  .monogram {
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 4px;
  }

  .brand-name {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav-cta {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text) !important;
    background: var(--surface);
  }

  .nav-cta:hover {
    border-color: var(--accent);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
    padding: 4.5rem 0 3.5rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  h1 {
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .summary {
    margin-top: 1.25rem;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--muted);
    max-width: 58ch;
  }

  .cta-row {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.2rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn:hover {
    border-color: var(--border-hover);
    background: var(--surface-2);
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #06140e;
    font-weight: 600;
  }

  .btn.primary:hover {
    background: #34d399;
    border-color: #34d399;
  }

  /* Profile Card */
  .profile-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.06em;
  }

  .accent {
    color: var(--accent);
  }

  .specs {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .specs dt {
    font-size: 0.68rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
  }

  .specs dd {
    font-size: 0.88rem;
    color: var(--text);
  }

  .email-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .copy-btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .copy-btn:hover,
  .copy-btn.copied {
    border-color: var(--accent);
    color: var(--accent);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 0.76rem;
  }

  .card-footer a {
    color: var(--muted);
    text-decoration: none;
  }

  .card-footer a:hover {
    color: var(--text);
  }

  /* Metrics */
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .metric-item {
    background: var(--surface);
    padding: 1.25rem;
  }

  .metric-value {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }

  .metric-label {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* Sections */
  .section {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    margin-bottom: 2rem;
  }

  .section-label {
    font-size: 0.74rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 1.65rem;
    letter-spacing: -0.02em;
  }

  /* Bento Grid */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .bento-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    transition: border-color 0.2s ease;
  }

  .bento-card:hover {
    border-color: var(--border-hover);
  }

  .bento-card.featured {
    border-color: rgba(16, 185, 129, 0.4);
    background: linear-gradient(180deg, rgba(16, 185, 129, 0.06) 0%, var(--surface) 60%);
  }

  .card-tag {
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .bento-card h3 {
    margin-top: 0.55rem;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  .bento-card p {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.62;
    color: var(--muted);
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .pill {
    font-size: 0.72rem;
    color: #d4d4d8;
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
  }

  .card-link {
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* Tech Stack */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .stack-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.4rem;
  }

  .stack-card h3 {
    font-size: 0.82rem;
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  /* Timeline */
  .timeline {
    display: flex;
